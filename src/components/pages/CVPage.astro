---
/**
 * Page CV, rendue à l'identique dans chaque langue.
 *
 * Le contenu vient de la collection `cv` (fr : `cv`, en : `en/cv`), les
 * libellés d'interface de `src/config/i18n.ts`. Les pages de `src/pages/`
 * ne font que choisir la langue.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceCard from '../ExperienceCard.astro';
import CVSection from '../cv/CVSection.astro';
import CVGrid from '../cv/CVGrid.astro';
import CVCard from '../cv/CVCard.astro';
import { getEntry } from 'astro:content';
import { contentIds, ui, type Locale } from '../../config/i18n.ts';
import { parseCVContent, assertCVComplete } from '../../utils/cvParser.ts';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const entryId = contentIds.cv[lang];

const cvEntry = await getEntry('cv', entryId);
if (!cvEntry) {
  throw new Error(`CV content not found for locale « ${lang} » (entrée « ${entryId} »)`);
}
if (!cvEntry.body) {
  throw new Error(`CV content is empty: l'entrée « ${entryId} » n'a pas de corps`);
}

// Parse structured data from Markdown content
const cvContent = parseCVContent(cvEntry.body, cvEntry.data);

// Le parser ignore en silence ce qu'il ne reconnaît pas, et son catch renvoie
// une structure vide : sans ce contrôle, un CV amputé se publierait sans erreur.
assertCVComplete(cvContent, `src/content/cv/${entryId}.md`);
---

<BaseLayout
  title={t.cv.meta.title}
  description={t.cv.meta.description}
  lang={lang}
  page="cv"
  theme={cvEntry.data.theme}
>
  <div class="pl-4 pr-4 sm:pl-6 sm:pr-6 lg:pl-page lg:pr-8 pt-6 sm:pt-8 pb-2 sm:pb-4">
    <header class="hero-section cv-animate" role="banner">
      <p class="hero-eyebrow">{t.cv.eyebrow}</p>
      <h1 id="main-title">{cvContent.name}</h1>
      <p class="hero-tagline">{cvEntry.data.title}</p>
      <div class="hero-rule"></div>
      <p class="hero-description">{cvEntry.data.description}</p>
    </header>

    <div class="cv-animate-grid cv-animate" style="animation-delay: 0.1s">
    <CVGrid lang={lang}>
      <CVCard title={t.cv.contact} id="contact-section" icon={cvContent.contactIcon}>
        <ul class="space-y-3">
          {cvContent.contactContent?.map((contactItem) => (
            <li class="text-body text-cv-content flex items-center">
              <span class="flex-1" set:html={contactItem}></span>
            </li>
          ))}
        </ul>
      </CVCard>

      <CVCard title={t.cv.interests} id="interests-section" icon={cvContent.interestsIcon}>
        <ul class="space-y-3">
          {cvContent.interests.map((interest) => (
            <li class="text-body text-cv-content flex items-center">
              <span class="flex-1" set:html={interest}></span>
            </li>
          ))}
        </ul>
      </CVCard>
    </CVGrid>
    </div>

    <div class="cv-animate" style="animation-delay: 0.3s">
      <CVSection title={t.cv.experience} subtitle={t.cv.experienceSubtitle} id="experience-section">
        {cvContent.experience.map((exp) => (
          <ExperienceCard
            lang={lang}
            company={exp.company}
            companyUrl={exp.companyUrl}
            role={exp.role}
            period={exp.period}
            current={exp.current}
            logo={exp.logo}
            icon={exp.icon}
          >
            {exp.achievements.map((achievement) => (
              <li class="text-body text-cv-content flex">
                <span set:html={achievement}></span>
              </li>
            ))}
          </ExperienceCard>
        ))}
      </CVSection>
    </div>

    <div class="cv-animate" style="animation-delay: 0.4s">
      <CVSection title={t.cv.skills} subtitle={t.cv.skillsSubtitle} id="skills-section">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-section">
          {cvContent.skills.map((skill) => (
            <ExperienceCard
              lang={lang}
              company={skill.title}
              role={skill.subtitle}
              period={skill.level}
              current={skill.current}
              icon={skill.icon}
              levelIcon={skill.levelIcon}
            >
              {skill.items.map((item) => (
                <li class="text-body text-cv-content flex">
                  <span set:html={item}></span>
                </li>
              ))}
            </ExperienceCard>
          ))}
        </div>
      </CVSection>
    </div>

    <div class="cv-animate" style="animation-delay: 0.5s">
      <CVSection title={t.cv.education} subtitle={t.cv.educationSubtitle} id="education-section">
        <div class="glass-card">
          <p class="text-body text-cv-content mb-4">{t.cv.autodidact}</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {cvContent.education.map((edu) => (
              <div>
                <span class="badge-lumon mb-2">{edu.period}</span>
                <h3 class="text-sm text-cv-content mb-1 font-semibold font-lora">{edu.title}</h3>
                <p class="text-body text-cv-muted">{edu.institution}</p>
              </div>
            ))}
          </div>
        </div>
      </CVSection>
    </div>
  </div>
</BaseLayout>
