---
import { renderIconSVG } from '../utils/iconSvg.ts';
import { ui, DEFAULT_LOCALE, type Locale } from '../config/i18n.ts';

export interface Props {
  company: string;
  companyUrl?: string;
  role?: string;
  period?: string;
  current?: boolean;
  logo?: string;
  description?: string[];
  icon?: string;
  levelIcon?: string;
  lang?: Locale;
}

const { company, companyUrl, role, period, current, logo, description, icon, levelIcon, lang = DEFAULT_LOCALE } = Astro.props;
const t = ui[lang].card;

// Generate initials as fallback for missing logos
const getInitials = (name: string) => {
  return name.split(' ').map(word => word.charAt(0)).join('').toUpperCase().slice(0, 2);
};

// Résolus localement au build — aucun appel réseau (risque R3 de la spec).
const iconSVG = icon
  ? renderIconSVG(icon, { width: '60%', height: '60%', color: '#d6e0e2' })
  : null;
const levelIconSVG = levelIcon
  ? renderIconSVG(levelIcon, { width: 24, height: 24, color: 'white' })
  : null;
---

<div class={`glass-card mb-4 sm:mb-6 lg:mb-section${current ? ' glass-card--current' : ''}`}>
  <div class="flex flex-col sm:grid sm:grid-cols-[3rem_1fr] lg:grid-cols-[4rem_1fr] gap-4 sm:gap-6">
    <!-- Logo Column -->
    <div class="w-12 h-12 sm:w-12 sm:h-12 lg:w-16 lg:h-16 flex items-center justify-center flex-shrink-0 mx-auto sm:mx-0 order-1 sm:order-none">
      {logo ? (
        <img 
          src={logo} 
          alt={t.logoAlt(company)} 
          class="w-full h-full object-contain"
          loading="lazy"
          decoding="async"
          width="64"
          height="64"
        />
      ) : (
        <div 
          class="w-full h-full bg-cv-accent text-white flex items-center justify-center text-sm font-semibold"
          aria-label={icon ? t.iconAlt(company) : t.initialsAlt(company)}
        >
          {icon && iconSVG ? (
            <div class="flex items-center justify-center w-full h-full" set:html={iconSVG} />
          ) : (
            getInitials(company)
          )}
        </div>
      )}
    </div>
    
    <!-- Content Column -->
    <div class="order-2 sm:order-none">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3 sm:mb-4 text-center sm:text-left">
        <div class="mb-2 sm:mb-0">
          <h3 class="text-lg sm:text-xl lg:text-company text-cv-content font-semibold font-lora">
            {companyUrl ? (
              <a 
                href={companyUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-cv-accent transition-colors hover:underline focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded"
                aria-label={t.companyLink(company)}
              >
                <span set:html={company}></span>
              </a>
            ) : (
              <span set:html={company}></span>
            )}
          </h3>
          {role && <p class="text-sm sm:text-base font-semibold text-cv-muted" set:html={role}></p>}
        </div>
        
        <!-- Level Badge -->
        <div class="flex flex-col items-center sm:items-end gap-1.5">
          {current && (
            <span class="badge-current">{t.currentBadge}</span>
          )}
          {period && (
            <span class="badge-lumon">
              {levelIcon && levelIconSVG ? (
                <div class="flex items-center justify-center w-5 h-5" set:html={levelIconSVG} />
              ) : null}
              <span class="font-ibm-plex-mono" set:html={period}></span>
            </span>
          )}
        </div>
      </div>
      
      <!-- Content: either description array or slot -->
      {description && description.length > 0 ? (
        <ul class="space-y-2 sm:space-y-2 text-left pl-0 sm:pl-4 border-l-0 sm:border-l-2 hover:border-transparent ml-0 sm:ml-2 transition-colors duration-300" style="border-color: #98b6b0;">
          {description.map((item) => (
            <li class="text-sm sm:text-base lg:text-body text-cv-content flex flex-col sm:flex-row sm:items-start">
              <span class="sm:flex-1">{item}</span>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="space-y-2 sm:space-y-2 text-left pl-0 sm:pl-4 border-l-0 sm:border-l-2 hover:border-transparent ml-0 sm:ml-2 transition-colors duration-300" style="border-color: #98b6b0;">
          <slot />
        </ul>
      )}
    </div>
  </div>
</div>