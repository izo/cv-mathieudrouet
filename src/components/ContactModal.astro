---
// Contact Modal Component — submits to the Cloudflare Pages Function /api/contact
---

<!-- Contact Modal -->
<div id="contact-modal" class="contact-overlay fixed inset-0 flex items-center justify-center z-50 hidden">
  <div class="contact-panel max-w-md w-full mx-4 max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <!-- Modal Header -->
    <div class="flex justify-between items-center gap-4 p-6 contact-panel__header">
      <h2 id="contact-modal-title" class="contact-title"><span class="contact-title__rule" aria-hidden="true"></span>Me contacter</h2>
      <button
        type="button"
        id="close-modal"
        class="contact-close"
        aria-label="Fermer la fenêtre de contact"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6">
      <!-- Message envoyé -->
      <div id="success-message" class="hidden contact-notice contact-notice--ok" role="status">
        <p class="contact-notice__title">Message envoyé</p>
        <p class="contact-notice__body">Je vous réponds sous quelques jours, à l'adresse que vous avez indiquée.</p>
      </div>

      <!-- Échec de l'envoi -->
      <div id="error-message" class="hidden contact-notice contact-notice--ko" role="alert">
        <p class="contact-notice__title">L'envoi a échoué</p>
        <p class="contact-notice__body" id="error-detail">Le message n'est pas parti. Réessayez, ou écrivez directement à <a href="mailto:m@mdr.cool" class="no-min-size contact-notice__link">m@mdr.cool</a>.</p>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        name="contact"
        method="POST"
        action="/api/contact"
        class="space-y-4"
      >
        <!-- Honeypot classique -->
        <div class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </div>
        <!-- Honeypot temporel : injecté par JS à l'ouverture de la modal -->
        <input type="hidden" name="_t" value="0" />

        <!-- Name Field -->
        <div>
          <label for="name" class="contact-label">
            Nom complet *
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required
            class="contact-field"
            placeholder="Votre nom et prénom"
          />
        </div>

        <!-- Email Field -->
        <div>
          <label for="email" class="contact-label">
            Email *
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            class="contact-field"
            placeholder="votre.email@exemple.com"
          />
        </div>

        <!-- Subject Field -->
        <div>
          <label for="subject" class="contact-label">
            Sujet *
          </label>
          <input 
            type="text" 
            id="subject" 
            name="subject" 
            required
            class="contact-field"
            placeholder="Objet de votre message"
          />
        </div>

        <!-- Message Field -->
        <div>
          <label for="message" class="contact-label">
            Message *
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="4" 
            required
            class="contact-field contact-field--area"
            placeholder="Votre message..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end space-x-3 pt-4">
          <button 
            type="button" 
            id="cancel-btn"
            class="contact-btn contact-btn--ghost"
          >
            Annuler
          </button>
          <button 
            type="submit" 
            id="submit-btn"
            class="contact-btn contact-btn--primary"
          >
            <span id="submit-text">Envoyer</span>
            <span id="submit-loading" class="hidden">
              <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Envoi...
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  /* Modale de contact — alignée sur DESIGN.md, « Le Bureau du Futur Antérieur ».
     Angles vifs, palette du système, ombre d'encre en réponse au geste.
     Voir docs/backlog/2026-07-28-spec-cv-humains-et-agents/ */

  /* Pas de noir pur (Règle du Noir Absent) : le voile est de l'Encre de Service. */
  .contact-overlay {
    background: rgba(22, 63, 56, 0.55);
  }

  /* Une fiche posée sur le bureau : la trame du monde la traverse, et l'ombre
     d'encre la décale franchement — même geste que les fiches au survol, à
     l'échelle d'un document qu'on vient de poser sur la table. */
  .contact-panel {
    background: var(--cv-card);
    background-image:
      linear-gradient(to right, var(--cv-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--cv-border) 1px, transparent 1px);
    background-size: 12.5px 12.5px;
    background-repeat: repeat;
    border: 2px solid var(--cv-content);
    border-radius: 0;
    box-shadow: 8px 8px 0 var(--cv-content);
  }

  .contact-panel__header {
    background: var(--cv-section);
    border-bottom: 2px solid var(--cv-content);
  }

  .contact-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-lora);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--cv-content);
    margin: 0;
  }

  /* Le même filet que les titres de section — la modale entre dans la grammaire. */
  .contact-title__rule {
    display: inline-block;
    flex: none;
    width: 4px;
    height: 1.5rem;
    background: var(--cv-accent);
    border-radius: 3px;
  }

  .contact-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    min-width: 44px;
    min-height: 44px;
    color: var(--cv-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
    cursor: pointer;
    transition: all var(--default-transition-duration) var(--ease-out);
  }
  .contact-close:hover {
    color: var(--cv-accent);
    border-color: var(--cv-accent);
  }
  .contact-close:focus-visible {
    outline: 2px solid var(--cv-focus);
    outline-offset: 2px;
  }

  /* — Retours d'envoi —
     Bordure franche de 1 px : le filet gauche de 3 px reste réservé au marqueur
     « en cours » des fiches, seul état du système. */
  .contact-notice {
    margin-bottom: 1.25rem;
    padding: 0.9rem 1rem;
    border-radius: 0;
    border: 1px solid var(--cv-content);
  }
  .contact-notice--ok {
    background: var(--cv-section);
    border-color: var(--cv-accent);
    box-shadow: 2px 2px 0 var(--cv-accent);
  }
  .contact-notice--ko {
    background: var(--cv-card);
    border-color: var(--cv-error);
    box-shadow: 2px 2px 0 var(--cv-error);
  }
  .contact-notice__title {
    font-family: var(--font-ibm-plex-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cv-content);
    margin: 0 0 0.35rem;
  }
  .contact-notice--ko .contact-notice__title {
    color: var(--cv-error);
  }
  .contact-notice__body {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--cv-content);
    margin: 0;
  }
  /* `p a` reçoit un padding de 2px 4px pour élargir la zone de clic. Utile
     verticalement, mais l'horizontal décolle la ponctuation qui suit le lien. */
  .contact-notice__link {
    color: var(--cv-content);
    text-decoration: underline;
    text-underline-offset: 2px;
    padding: 2px 0;
    min-width: 0;
    min-height: 0;
  }
  .contact-notice__link:hover {
    color: var(--cv-accent);
  }

  /* — Champs — */
  .contact-label {
    display: block;
    font-family: var(--font-ibm-plex-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cv-muted);
    margin-bottom: 0.4rem;
  }

  /* Les champs sont opaques : ils creusent la trame plutôt que de la laisser
     courir sous le texte qu'on saisit. */
  .contact-field {
    width: 100%;
    font-family: var(--font-ibm-plex);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--cv-content);
    background: var(--cv-bg);
    border: 1px solid var(--cv-content);
    border-radius: 0;
    padding: 0.65rem 0.75rem;
    min-height: 44px;
    transition: all var(--default-transition-duration) var(--ease-out);
  }
  /* Contraste AA tenu jusque sur l'indication : un placeholder pâle serait illisible. */
  .contact-field::placeholder {
    color: var(--cv-muted);
    opacity: 1;
  }
  .contact-field:hover {
    border-color: var(--cv-muted);
  }
  /* Un seul geste de focus : la bordure passe à l'accent et l'ombre d'encre se
     décale. Un outline par-dessus recouvrait les deux et ramenait un cadre
     générique — la forme change autant que la couleur, l'indication tient. */
  .contact-field:focus,
  .contact-field:focus-visible {
    outline: none;
    border-color: var(--cv-accent);
    box-shadow: 2px 2px 0 var(--cv-accent);
  }
  .contact-field:invalid:not(:placeholder-shown) {
    border-color: var(--cv-error);
  }
  .contact-field--area {
    resize: vertical;
    min-height: 7rem;
  }

  /* — Boutons —
     Le primaire est en Encre de Service, pas en accent : un aplat de Vert
     Terminal violerait la Règle de l'Accent Rare, et le texte clair n'y
     atteindrait pas le contraste AA. L'accent reste au geste (ombre, bordure). */
  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ibm-plex-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.85rem 1.5rem;
    min-height: 44px;
    border-radius: 0;
    cursor: pointer;
    transition: all var(--default-transition-duration) var(--ease-out);
  }
  .contact-btn:focus-visible {
    outline: 2px solid var(--cv-focus);
    outline-offset: 2px;
  }

  .contact-btn--primary {
    background: var(--cv-content);
    color: var(--cv-card);
    border: 1px solid var(--cv-content);
  }
  .contact-btn--primary:hover:not(:disabled) {
    box-shadow: 2px 2px 0 var(--cv-accent);
    border-color: var(--cv-accent);
  }
  .contact-btn--primary:active:not(:disabled) {
    box-shadow: none;
    transform: translate(1px, 1px);
  }
  .contact-btn--primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .contact-btn--ghost {
    background: var(--cv-card);
    color: var(--cv-content);
    border: 1px solid var(--cv-border);
  }
  .contact-btn--ghost:hover {
    border-color: var(--cv-accent);
    box-shadow: 2px 2px 0 var(--cv-accent);
  }
  .contact-btn--ghost:active {
    box-shadow: none;
    transform: translate(1px, 1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-btn:active,
    .contact-btn--ghost:active {
      transform: none;
    }
  }
</style>

<script>
  // Contact Modal JavaScript
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('contact-modal') as HTMLElement;
    const closeBtn = document.getElementById('close-modal') as HTMLButtonElement;
    const cancelBtn = document.getElementById('cancel-btn') as HTMLButtonElement;
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text') as HTMLElement;
    const submitLoading = document.getElementById('submit-loading') as HTMLElement;
    const successMessage = document.getElementById('success-message') as HTMLElement;
    const errorMessage = document.getElementById('error-message') as HTMLElement;

    // Declare global function for opening modal
    (window as any).openContactModal = function() {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Honeypot temporel : timestamp injecté à l'ouverture (pas au chargement SSG)
      const tInput = form?.querySelector('input[name="_t"]') as HTMLInputElement | null;
      if (tInput) tInput.value = String(Date.now());

      // Focus first input
      setTimeout(() => {
        const nameInput = document.getElementById('name') as HTMLInputElement;
        nameInput?.focus();
      }, 100);
    };

    // Function to close modal
    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      
      // Reset form and messages
      form?.reset();
      successMessage?.classList.add('hidden');
      errorMessage?.classList.add('hidden');
      form?.classList.remove('hidden');
    }

    // Event listeners for closing modal
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);
    
    // Close on backdrop click
    modal?.addEventListener('click', function(e) {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Form submission
    form?.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Un échec précédent ne doit pas survivre à la nouvelle tentative.
      errorMessage?.classList.add('hidden');

      // Show loading state
      if (submitBtn) submitBtn.disabled = true;
      submitText?.classList.add('hidden');
      submitLoading?.classList.remove('hidden');

      try {
        // Create FormData
        const formData = new FormData(form);

        // Convert FormData to URLSearchParams (form-urlencoded body)
        const params = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          params.append(key, value.toString());
        }

        // Submit to the Cloudflare Pages Function
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString()
        });

        if (response.ok) {
          // Show success message
          form?.classList.add('hidden');
          successMessage?.classList.remove('hidden');
          
          // Auto-close after 3 seconds
          setTimeout(() => {
            closeModal();
          }, 3000);
        } else {
          throw new Error('Network response was not ok');
        }
      } catch (error) {
        console.error('Error:', error);
        // Le message d'échec vit dans la modale : un alert() natif sort du
        // système, bloque la page et ne dit pas comment s'en sortir.
        errorMessage?.classList.remove('hidden');
        errorMessage?.scrollIntoView({ block: 'nearest' });
      } finally {
        // Reset loading state
        if (submitBtn) submitBtn.disabled = false;
        submitText?.classList.remove('hidden');
        submitLoading?.classList.add('hidden');
      }
    });
  });
</script>
