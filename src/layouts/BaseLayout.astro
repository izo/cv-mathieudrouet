---
import '../styles/global.css';
import { siteConfig } from '../config/site.ts';
import { securityConfig, isDevelopment } from '../config/env.ts';
import {
  ui,
  routes,
  markdownRoutes,
  alternatesFor,
  otherLocale,
  DEFAULT_LOCALE,
  type Locale,
  type PageId,
} from '../config/i18n.ts';
import ContactModal from '../components/ContactModal.astro';
import { renderIconSVG } from '../utils/iconSvg.ts';

export interface Props {
  title: string;
  description: string;
  showFooter?: boolean;
  image?: string;
  url?: string;
  enableDebugMode?: boolean;
  theme?: string;
  /** Langue de la page — pilote `<html lang>`, les libellés et les alternates. */
  lang?: Locale;
  /** Page traduite rendue ici. `other` = pas d'équivalent dans l'autre langue. */
  page?: PageId;
}

const { 
  title, 
  description, 
  showFooter = true, 
  image = siteConfig.author.image, 
  url,
  enableDebugMode = isDevelopment(),
  theme = "lumon",
  lang = DEFAULT_LOCALE,
  page = 'other'
} = Astro.props;

const canonicalUrl = url || Astro.url.href;
const fullImageUrl = new URL(image, siteConfig.url).href;

const t = ui[lang];

// Les alternates viennent de l'identité de la page, pas de son URL : en
// `build.format: 'directory'`, `Astro.url.pathname` porte un slash final que
// les comparaisons de chemin rataient (le /about servait le cv.md).
const alternates = alternatesFor(page);
const markdownHref = page === 'other' ? null : markdownRoutes[page][lang];
const xDefaultHref =
  page === 'other' ? null : new URL(routes[page][DEFAULT_LOCALE], siteConfig.url).href;

// Le site n'a que deux langues : le sélecteur est un aller-retour. Une page
// sans équivalent traduit (404) renvoie vers le CV de l'autre langue.
const switchLocale = otherLocale(lang);
const switchHref = page === 'other' ? routes.cv[switchLocale] : routes[page][switchLocale];

// Les outils WebMCP servent la langue de la page où ils sont enregistrés.
const cvMarkdownHref = markdownRoutes.cv[lang];
const aboutMarkdownHref = markdownRoutes.about[lang];
const pdfHref = lang === 'fr' ? '/CV-Mathieu-Drouet-FR.pdf' : '/CV-Mathieu-Drouet-EN.pdf';
const pdfDownloadName = lang === 'fr' ? 'CV-Mathieu-Drouet-FR.pdf' : 'CV-Mathieu-Drouet-EN.pdf';
---

<!doctype html>
<html lang={t.htmlLang} class="h-full" data-theme={theme} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Agent discovery (RFC 8288 link relations) -->
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    {markdownHref && (
      <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version" />
    )}
    <link rel="alternate" type="application/pdf" href={pdfHref} title="CV (PDF)" />

    <!-- Versions linguistiques (hreflang) — mêmes URL que les canoniques -->
    {alternates.map(({ locale, path }) => (
      <link rel="alternate" hreflang={locale} href={new URL(path, siteConfig.url).href} />
    ))}
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    <!-- SEO Meta Tags -->
    <meta name="author" content={siteConfig.author.name} />
    <meta name="keywords" content={siteConfig.seo.keywords.join(", ")} />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={t.ogLocale} />
    {alternates.length > 0 && (
      <meta property="og:locale:alternate" content={ui[switchLocale].ogLocale} />
    )}
    <meta property="profile:first_name" content="Mathieu" />
    <meta property="profile:last_name" content="Drouet" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    
    <!-- Additional Meta -->
    <meta name="theme-color" content={siteConfig.seo.themeColor} />
    <meta name="msapplication-TileColor" content={siteConfig.seo.themeColor} />

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": new URL("/#mathieu-drouet", siteConfig.url).href,
      "name": siteConfig.author.name,
      "jobTitle": siteConfig.author.jobTitle,
      "url": siteConfig.url,
      "image": new URL(siteConfig.author.image, siteConfig.url).href,
      "email": siteConfig.author.email,
      "telephone": siteConfig.author.phone,
      "sameAs": [
        siteConfig.social.linkedin.url,
        siteConfig.social.github.url,
        siteConfig.social.portfolio.url
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lille",
        "addressRegion": "Hauts-de-France",
        "addressCountry": "FR"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "Institut Supérieur d'Architecture Saint-Luc",
          "address": { "@type": "PostalAddress", "addressLocality": "Tournai", "addressCountry": "BE" }
        },
        {
          "@type": "EducationalOrganization",
          "name": "Simplon.co",
          "address": { "@type": "PostalAddress", "addressLocality": "Lille", "addressCountry": "FR" }
        }
      ],
      "knowsAbout": [
        "Product Strategy",
        "Product Management",
        "Technology Strategy",
        "Software Architecture",
        "Artificial Intelligence",
        "AI Architecture",
        "Large Language Models",
        "Agentic AI",
        "AI Agents",
        "Model Context Protocol",
        "Retrieval-Augmented Generation",
        "MusicTech",
        "LiveTech",
        "Digital Transformation",
        "B2B Software",
        "UX Strategy"
      ]
    })} />

    <!-- Critical CSS inlined to prevent FOUC -->
    <style>
      /* Critical base styles to prevent FOUC */
      html { height: 100%; }
      body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        background-color: #f7f6f9;
        color: #163f38;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>

    <!-- Preload critical font (IBM Plex Sans 400 latin — used for all body text) -->
    <link rel="preload" href="/fonts/ibm-plex-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Performance optimizations -->
    <!-- Image preload removed as profile.jpg is not used on main page -->
    
    <!-- Security Headers - Note: 'unsafe-inline' required for Astro's is:inline scripts and critical CSS.
         Les icônes sont résolues au build depuis @iconify-json/carbon : plus aucune origine
         tierce dans la politique. Doit rester identique à public/_headers. -->
    {securityConfig.enableCSP && (
      <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-elem 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';${isDevelopment() ? '' : ' upgrade-insecure-requests;'}`} />
    )}
    
    <title>{title}</title>
  </head>
  <body class="min-h-full font-sans text-cv-content antialiased" itemscope itemtype="https://schema.org/ProfilePage">
    <!-- Skip Links for Accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-cv-accent focus:text-white focus:rounded focus:no-underline focus:shadow-lg">{t.skipToContent}</a>
    
    <!-- Main content container -->
    <div class="lumon-container">
      <!-- Content -->
      <div class="relative z-10">
        <!-- Main content slot -->
        <main id="main-content" role="main" class="focus:outline-none" tabindex="-1">
          <slot name="content">
            <slot />
          </slot>
        </main>
        
        <!-- Footer (conditional) -->
        {showFooter && (
          <div class="pl-4 pr-4 sm:pl-6 sm:pr-6 lg:pl-page lg:pr-8">
            <footer class="glass-card mt-4 sm:mt-6" role="contentinfo">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                <p class="text-xs text-cv-muted order-2 sm:order-1 font-ibm-plex-mono">&copy; {new Date().getFullYear()} {siteConfig.author.name}</p>
                <div class="flex items-center gap-3 order-1 sm:order-2">
                  <a href={routes.about[lang]} class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" aria-label={t.footer.about}>
                    <Fragment set:html={renderIconSVG('carbon:user-profile', { width: 16, height: 16, class: 'inline-block' })} />
                  </a>
                  <a 
                    href={pdfHref}
                    download={pdfDownloadName}
                    class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" 
                    aria-label={t.footer.downloadPdf}
                  >
                    <Fragment set:html={renderIconSVG('carbon:document-pdf', { width: 16, height: 16, class: 'inline-block' })} />
                  </a>
                  <a href={siteConfig.social.linkedin.url} target="_blank" rel="noopener noreferrer" class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" aria-label={t.footer.linkedin}>
                    <Fragment set:html={renderIconSVG('carbon:logo-linkedin', { width: 16, height: 16, class: 'inline-block' })} />
                  </a>
                  <a href={siteConfig.social.github.url} target="_blank" rel="noopener noreferrer" class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" aria-label={t.footer.github}>
                    <Fragment set:html={renderIconSVG('carbon:logo-github', { width: 16, height: 16, class: 'inline-block' })} />
                  </a>
                  <a href={siteConfig.social.portfolio.url} target="_blank" rel="noopener noreferrer" class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" aria-label={t.footer.portfolio}>
                    <Fragment set:html={renderIconSVG('carbon:ibm-cloud-vpc-images', { width: 16, height: 16, class: 'inline-block' })} />
                  </a>
                  <button onclick="openContactModal()" class="text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded p-1" aria-label={t.footer.contact}>
                    <Fragment set:html={renderIconSVG('carbon:email', { width: 16, height: 16, class: 'inline-block' })} />
                  </button>
                  <a
                    href={switchHref}
                    hreflang={switchLocale}
                    lang={switchLocale}
                    class="lang-switch text-cv-muted hover:text-cv-accent transition-colors focus:outline-none focus:ring-2 focus:ring-cv-accent focus:rounded font-ibm-plex-mono"
                    aria-label={t.languageSwitch.ariaLabel}
                  >{t.languageSwitch.label}</a>
                </div>
              </div>
            </footer>
          </div>
        )}
      </div>
    </div>
    
    <!-- Debug mode activation -->
    <script is:inline define:vars={{ enableDebugMode }}>
      if (enableDebugMode) {
        console.log('🔧 CV Debug Mode Active');
        console.log('Environment:', 'development');
        console.log('Available debug tools: __cvDebug');
        if (typeof window !== 'undefined' && window.__cvDebug) {
          window.__cvDebug.help();
        }
      }
    </script>

    <!-- WebMCP: expose site tools to AI agents (https://webmachinelearning.github.io/webmcp/) -->
    <script is:inline define:vars={{ cvMarkdownHref, aboutMarkdownHref, pdfHref, pdfDownloadName }}>
      (function registerWebMCPTools() {
        if (typeof navigator === 'undefined') return;
        var mc = navigator.modelContext;
        if (!mc || typeof mc.provideContext !== 'function') return;

        try {
          mc.provideContext({
            tools: [
              {
                name: 'get_cv_markdown',
                description: "Fetch Mathieu Drouet's full CV (Chief AI, Technology & Product Officer — Product, Technology & AI, Lille, France) as Markdown.",
                inputSchema: { type: 'object', properties: {}, additionalProperties: false },
                execute: async function () {
                  var res = await fetch(cvMarkdownHref, { headers: { 'Accept': 'text/markdown' } });
                  if (!res.ok) throw new Error('CV markdown unavailable (HTTP ' + res.status + ')');
                  var markdown = await res.text();
                  return { content: [{ type: 'text', text: markdown }] };
                }
              },
              {
                name: 'get_about_markdown',
                description: "Fetch Mathieu Drouet's long-form about page covering Product, Technology, AI architecture, agentic systems and hands-on delivery as Markdown.",
                inputSchema: { type: 'object', properties: {}, additionalProperties: false },
                execute: async function () {
                  var res = await fetch(aboutMarkdownHref, { headers: { 'Accept': 'text/markdown' } });
                  if (!res.ok) throw new Error('About markdown unavailable (HTTP ' + res.status + ')');
                  var markdown = await res.text();
                  return { content: [{ type: 'text', text: markdown }] };
                }
              },
              {
                name: 'download_cv_pdf',
                description: "Trigger a browser download of Mathieu Drouet's CV as a PDF file.",
                inputSchema: { type: 'object', properties: {}, additionalProperties: false },
                execute: async function () {
                  var a = document.createElement('a');
                  a.href = pdfHref;
                  a.download = pdfDownloadName;
                  document.body.appendChild(a);
                  a.click();
                  a.remove();
                  return { content: [{ type: 'text', text: 'CV PDF download started.' }] };
                }
              },
              {
                name: 'open_contact_form',
                description: "Open the contact form modal so the user can send a message to Mathieu Drouet.",
                inputSchema: { type: 'object', properties: {}, additionalProperties: false },
                execute: async function () {
                  if (typeof window.openContactModal === 'function') {
                    window.openContactModal();
                    return { content: [{ type: 'text', text: 'Contact form opened.' }] };
                  }
                  return { content: [{ type: 'text', text: 'Contact form is not available on this page.' }], isError: true };
                }
              }
            ]
          });
        } catch (err) {
          console.warn('WebMCP registration failed:', err);
        }
      })();
    </script>
    

    

    
    <!-- Contact Modal -->
    <ContactModal lang={lang} />
  </body>
</html>